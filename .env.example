# ==============================================================================
# My Work Planner PWA — Environment Variables Template
# Copy to .env for local development. Never commit real secrets to git.
# ==============================================================================

# --- Client-Safe Variables (exposed to Vite browser bundle via import.meta.env) ---
# Public Supabase project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=""
# Public Supabase publishable / anon key (safe for browser use with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Canonical application base URL used for Magic Link callbacks (e.g., http://localhost:3000)
VITE_APP_BASE_URL="http://localhost:3000"

# --- Server-Only Variables (NEVER prefix with VITE_ or import in browser code) ---
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Privileged Supabase secret / service-role key — strictly server-side only
SUPABASE_SECRET_KEY=""

# Google OAuth & Calendar Integration (Milestone 6 — server-side OAuth token exchange)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Application Base URL & Private Owner Access Allowlist
APP_BASE_URL="http://localhost:3000"
ALLOWED_USER_EMAILS=""
